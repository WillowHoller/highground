+.frame>.topbar .demo-bar{display:inline-flex;align-items:center;gap:4px;background:rgba(255,255,255,.14);color:#fff;border:1px solid rgba(255,255,255,.34);border-radius:999px;padding:3px 10px;font:600 12px/1.4 var(--sans);letter-spacing:.01em;white-space:nowrap}
+.frame>.topbar button.demo-bar{cursor:pointer}
+.frame>.topbar button.demo-bar:hover{background:rgba(255,255,255,.24)}
+.frame>.topbar button.demo-bar svg{opacity:.75}
+/* a light brand color: dark text, icons and tag, a hairline under the bar */
+.frame>.topbar.tb-light{color:var(--text);box-shadow:inset 0 -1px 0 rgba(0,0,0,.1)}
+.frame>.topbar.tb-light .panelbtn,.frame>.topbar.tb-light .helpbtn,.frame>.topbar.tb-light .menu-btn{color:rgba(28,42,36,.8)}
+.frame>.topbar.tb-light .panelbtn:hover,.frame>.topbar.tb-light .helpbtn:hover{background:rgba(0,0,0,.07);color:var(--text)}
+.frame>.topbar.tb-light .demo-bar{background:rgba(0,0,0,.06);color:var(--text);border-color:rgba(0,0,0,.22)}
+.frame>.topbar.tb-light button.demo-bar:hover{background:rgba(0,0,0,.11)}
+.frame>.topbar.tb-light .scen-top .ctl{border-color:rgba(0,0,0,.18);background:rgba(0,0,0,.04);color:var(--muted)}
+.frame>.topbar.tb-light .scen-top select,.frame>.topbar.tb-light .scen-top .ctl.ro b{color:var(--text)}
+/* a dark brand color: the bar's glass and secondary text stay readable on any hue */
+.frame>.topbar.tb-dark .panelbtn,.frame>.topbar.tb-dark .helpbtn{color:rgba(255,255,255,.82)}
+.frame>.topbar.tb-dark .scen-top .ctl{border-color:rgba(255,255,255,.22);background:rgba(255,255,255,.08);color:rgba(255,255,255,.78)}
 .rail{grid-column:1;grid-row:2;position:sticky;top:62px;height:calc(100vh / var(--z, 1) - 62px);background:var(--side);border-right:1px solid var(--border);color:var(--text);overflow-y:auto;overflow-x:hidden}
 .rail-menu{display:flex;flex-direction:column;gap:6px;min-height:100%;padding:10px 8px 8px}
 .org{display:flex;align-items:center;gap:8px;padding:4px 6px 10px;flex-wrap:wrap;border-bottom:1px solid var(--border);margin-bottom:4px}
